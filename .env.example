# Collect a rating and send the submitter a copy of their feedback.
# The blank secrets are intentional; supply them in your private .env or deployment settings.
# The email guide is in docs/email-setup.md; development log mode works without provider credentials.

APP_URL=http://localhost:3000 # Set this to the feedback page origin so its form passes the origin check.
HOST=127.0.0.1 # Bind the server here. The default accepts connections from this machine only.
PORT=3000 # Set the production listener port here; the dev server has its own configuration.
DB_PATH=.data/app.sqlite # Ratings, feedback text, and receipt email status; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # Set a random 16+ character password to read feedback and receipt status. Sign in as admin.
OWNER_EMAIL=owner@example.com # Not used for feedback receipts; this setting can be left empty.
REVIEWER_EMAIL=reviewer@example.com # Ignored by this workflow; feedback receipts do not use a configured reviewer.
MAIL_MODE=sandbox # For feedback receipts: sandbox for capture, production for real sending, log for local development.
MAIL_FROM=sender@example.com # Address sending feedback receipts; for production, choose one on your verified Mailtrap domain.
MAILTRAP_PRODUCTION_TOKEN= # Add your Mailtrap transactional token here to send feedback receipts in production.
MAILTRAP_SANDBOX_TOKEN= # API token with access to the Sandbox used for feedback receipt messages.
MAILTRAP_INBOX_ID= # Numeric Sandbox ID from its API integration settings; captured feedback email stays here.
